# Envelock web client — build-time configuration (Vite).
#
#   cp .env.example .env.production      # for local production builds
#   …or set these in the Vercel dashboard (Project → Settings → Environment
#     Variables) so the deployed build picks them up.
#
# Note: .env / .env.* are gitignored (only this .env.example is committed), so a
# committed file will NOT reach Vercel — use the Vercel dashboard for the deploy.

# Base URL of the Envelock API (the Render backend). The client calls this
# directly; a relative "/api/..." would hit the static host (Vercel) itself,
# which is the "calling itself → 500 / CORS" failure. In a PRODUCTION build the
# client already defaults to the Render URL even when this is unset — set it
# explicitly to target a different backend (staging, your own domain, etc.).
VITE_API_BASE_URL=https://envelockserver.onrender.com
